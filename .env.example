# Copy to .env and fill in real values. Never commit the filled-in .env file.

DATABASE_URL=mysql://user:password@localhost:3306/job_search_dashboard
JWT_SECRET=replace-with-a-long-random-secret
OWNER_OPEN_ID=replace-with-the-owner-identity-from-your-oauth-provider
OAUTH_SERVER_URL=https://example-oauth-provider.example.com
VITE_APP_ID=replace-with-your-oauth-client-app-id

# Telegram approval workflow (server/telegram.ts). The webhook secret and
# per-application approval nonces are derived from JWT_SECRET, not a separate variable.
TELEGRAM_BOT_TOKEN=

# Backing storage proxy used by server/_core/storageProxy.ts for presigned file access.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# LLM provider (server/_core/llm.ts) - get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Job search (server/jobSearch/adzuna.ts) - free, no card required, sign up at
# https://developer.adzuna.com. Without these, the bot still onboards users but
# skips the automatic search and tells them so.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter Adzuna country code jobs are searched in (default "ca" — Canada).
# There's no per-user country field yet, so this is one fixed value for the
# whole deployment.
# ADZUNA_DEFAULT_COUNTRY=ca

# Optional: preferred port (default 3000, auto-increments if busy)
# PORT=3000
